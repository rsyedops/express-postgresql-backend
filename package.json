{
  "name": "realworld-express-ts-postgres-drizzle",
  "version": "1.0.0",
  "description": "Exemplary Medium.com clone backend API implementation with Typescript + Express + PostgresQL + Drizzle",
  "scripts": {
    "dev": "tsx -C development --watch src/server.ts",
    "seed": "tsx -C development src/db/seed.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "prepare": "husky",
    "generate": "tsx -C development node_modules/drizzle-kit/bin.cjs generate",
    "migrate": "tsx -C development node_modules/drizzle-kit/bin.cjs migrate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhmedFawzy31/Realworld-Express-TS-Postgres-Drizzle.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/AhmedFawzy31/Realworld-Express-TS-Postgres-Drizzle/issues"
  },
  "homepage": "https://github.com/AhmedFawzy31/Realworld-Express-TS-Postgres-Drizzle#readme",
  "imports": {
    "#*": {
      "development": "./src/*",
      "default": "./dist/src/*"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint",
      "prettier --check"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --check"
    ]
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "slugify": "^1.6.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.12",
    "@vitest/eslint-plugin": "^1.4.3",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9.39.1",
    "eslint-plugin-perfectionist": "^4.15.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.0.12"
  }
}
